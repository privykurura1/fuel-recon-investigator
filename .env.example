# Copy these into your .env (keep real values out of GitHub)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: a deeper model for the final report
METERLESS_REPORT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: the station database that uploads are written to (defaults shown)
# STATION_DB_HOST=127.0.0.1
# STATION_DB_PORT=5433
# STATION_DB_USER=station
# STATION_DB_PASSWORD=StationDemo2026
